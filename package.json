{
  "name": "@augmentev/fabric-verify-mcp",
  "version": "0.1.2",
  "description": "MCP server for Fabric Verify: your agent signs a record of each action locally and gets a public, offline-checkable proof that the record existed, unchanged, by a certain time.",
  "mcpName": "ai.augmentev/fabric-verify",
  "type": "module",
  "bin": {
    "fabric-verify-mcp": "src/cli.js"
  },
  "main": "src/server.js",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:e2e": "node --test test/e2e.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "audit",
    "transparency-log",
    "ed25519"
  ],
  "homepage": "https://augmentev.com/fabric-verify",
  "bugs": {
    "url": "https://github.com/augmentev/fabric-verify-mcp/issues",
    "email": "support@augmentev.com"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augmentev/fabric-verify-mcp.git"
  }
}
